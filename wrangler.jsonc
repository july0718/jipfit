{
  "name": "jipfit",
  "main": "frontend/_worker.js",
  "compatibility_date": "2026-11-18",
  "keep_vars": true,
  "build": {
    "command": "npm --prefix frontend install --include=dev --no-audit --no-fund && npm --prefix frontend run build && cp frontend/index.html frontend/style.css frontend/config.js frontend/dist/"
  },
  "assets": {
    "directory": "frontend/dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  }
}
